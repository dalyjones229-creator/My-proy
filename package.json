{
  "name": "soap-ecommerce",
  "version": "0.1.0",
  "description": "Plataforma de comercio electronico para jabones artesanales y cosmetica natural (Clean Architecture / Screaming Architecture).",
  "private": true,
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit",
    "typecheck:worker": "tsc --noEmit --project worker/tsconfig.json",
    "dev": "ts-node src/index.ts",
    "start": "ts-node src/web/server.ts",
    "deploy": "wrangler deploy",
    "deploy:dry": "wrangler deploy --dry-run"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260926.1",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0",
    "wrangler": "^4.141.0"
  },
  "dependencies": {
    "express": "^4.19.2",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.20"
  }
}
